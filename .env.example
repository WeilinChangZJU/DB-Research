# Copy to .env and fill in your values.
# Single OpenAI-compatible endpoint for all LLM calls (generation, judging, baselines).
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Data generation model (profiles, dialogues, questions).
BEMULA_GEN_MODEL=gpt-5.6-luna

# LLM-as-Judge model for evaluation.
BEMULA_JUDGE_MODEL=deepseek-flash

# Answer model used by the memory baselines.
BEMULA_AGENT_MODEL=deepseek-flash

# "disabled" avoids hidden reasoning tokens on DeepSeek / gpt-5* / Qwen3 models.
BEMULA_THINKING=disabled

# Embedding backend for baselines: "api" (endpoint below) or "local" (sentence-transformers).
BEMULA_EMBED_BACKEND=api
BEMULA_EMBED_MODEL=text-embedding-3-small

# Optional dedicated embedding endpoint; falls back to OPENAI_* when unset.
# EMBED_PROXY_BASE_URL=
# EMBED_PROXY_API_KEY=

# Local embedding model used when BEMULA_EMBED_BACKEND=local.
BEMULA_HF_EMBED_MODEL=all-MiniLM-L6-v2

# Official repository clones for the repo-backed baselines
# (if unset, each adapter also tries a sibling ../<Repo> directory).
BEMULA_AMEM_PATH=/path/to/A-mem
BEMULA_SIMPLEMEM_PATH=/path/to/SimpleMem
BEMULA_MEMORYOS_PATH=/path/to/MemoryOS
BEMULA_LIGHTMEM_PATH=/path/to/LightMem

