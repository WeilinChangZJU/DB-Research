# Copy this file to .env inside WSL and fill in the key locally.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
BEMULA_GEN_MODEL=deepseek-flash
BEMULA_JUDGE_MODEL=deepseek-flash
BEMULA_AGENT_MODEL=deepseek-flash
BEMULA_THINKING=disabled

# DeepSeek's public API is used for chat only. Its public endpoint does not
# expose the declared text-embedding-3-small API. For the cost-bounded Q01
# pilot, use the cached local sentence-transformers model instead.
BEMULA_EMBED_BACKEND=local
BEMULA_HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For a separate compatible embedding service, switch to:
# BEMULA_EMBED_BACKEND=api
# BEMULA_EMBED_MODEL=text-embedding-3-small
# EMBED_PROXY_BASE_URL=
# EMBED_PROXY_API_KEY=
